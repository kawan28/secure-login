# Copie este arquivo para ".env" e preencha com os seus dados.
# O arquivo .env NÃO deve ser enviado ao GitHub (já está no .gitignore).

# String de conexão do MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=SecureLogin
MONGODB_DATABASE=securelogin

# Administrador inicial (criado no primeiro start se não existir nenhum ADMIN)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@admin.com
# Mínimo 8 caracteres com maiúscula, minúscula, número e caractere especial
ADMIN_PASSWORD=Troque@Esta1

# Tema visual: padrao | escuro
APP_THEME=padrao
APP_NAME=Secure Login

# Use true quando a aplicação estiver atrás de HTTPS
COOKIE_SECURE=false
